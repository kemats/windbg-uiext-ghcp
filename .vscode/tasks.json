{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "WinDbg: build, install, launch",
            "type": "process",
            "command": "pwsh",
            "args": [
                "-NoLogo",
                "-NoProfile",
                "-File",
                "${workspaceFolder}/scripts/debug.ps1"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": "$msCompile",
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        }
    ]
}