<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WinDbgChatView</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../WinDbgChatView/ChatExtension.cs" Link="ChatExtension.cs" />
    <ProjectReference Include="../Contracts/Contracts.csproj" />
    <ProjectReference Include="../WinDbgChatView/WinDbgChatView.csproj" ReferenceOutputAssembly="false" Private="false" />
    <PackageReference Include="Microsoft.Debugging.Platform.DbgX" Version="20260320.1.0" ExcludeAssets="build;buildTransitive" />
    <PackageReference Include="Fluent.Ribbon" Version="11.0.1" />
  </ItemGroup>
</Project>